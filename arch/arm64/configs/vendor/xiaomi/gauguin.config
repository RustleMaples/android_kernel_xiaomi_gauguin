# CONFIG_FSL_ERRATUM_A008585 is not set
# CONFIG_HISILICON_ERRATUM_161600802 is not set
# CONFIG_HISILICON_ERRATUM_161010101 is not set
# CONFIG_HW_RANDOM_CAVIUM is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_E1041 is not set
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set
# CONFIG_SOCIONEXT_SYNQUACER_PREITS is not set

# BT
# CONFIG_BT_BREDR is not set
# CONFIG_BT_LE is not set

# CPU Boost
# CONFIG_CPU_BOOST is not set
# CONFIG_MSM_PERFORMANCE is not set

# OEM Power drivers
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_ONEWIRE_GPIO=y

# Touchscreen driver
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
# CONFIG_TOUCHSCREEN_FTS is not set

# Fingerprint drivers
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX=y

# Netlabel
CONFIG_NETLABEL=y

# PStore configs
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# RmNet
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# IR drivers
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# exFAT
CONFIG_EXFAT_FS=y

# Unicode
# CONFIG_SDCARD_FS is not set

# Cmdline
CONFIG_CMDLINE="cgroup_disable=pressure,memory ramoops_memreserve=4M"

# RD
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
CONFIG_RD_LZ4=y

# Serial
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_FASTBOOT_CMD_CTRL_UART=y

# FSA I2C
# CONFIG_QCOM_FSA4480_I2C is not set

# Vibrator
CONFIG_INPUT_AW8624_HAPTIC=y
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# Power Efficiency & Stability
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Network: TCP BBR
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
# CONFIG_DEFAULT_PFIFO_FAST is not set
CONFIG_DEFAULT_NET_SCH="fq_codel"
CONFIG_NET_SCH_CAKE=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_BPF_EVENTS=y

# ZRAM ZSTD support & Writeback
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_ZRAM_DEDUP is not set

# Scheduler, 300Hz Frame Pacing & Utilization Clamping
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500

# Storage I/O & F2FS Compression
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_DEFAULT_NOOP=y
# CONFIG_DEFAULT_CFQ is not set
CONFIG_DEFAULT_IOSCHED="noop"
CONFIG_MQ_IOSCHED_KYBER=y

# ARMv8 Hardware Crypto & Compression Acceleration
CONFIG_CRYPTO_CRC32_ARM64_CE=y
CONFIG_CRYPTO_LZ4HC=y

# Safe Debug & Stats Overhead Reduction (Keeping IPC_LOGGING, CFI_CLANG & MSM_RTB intact)
# CONFIG_DEBUG_INFO is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_SCSI_LOGGING is not set
# CONFIG_TTY_PRINTK is not set
# CONFIG_QTI_DDR_STATS_LOG is not set
# CONFIG_QTI_RPM_STATS_LOG is not set
# CONFIG_MSM_BOOT_STATS is not set
# CONFIG_KFENCE is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_HARDENED_USERCOPY_PAGESPAN is not set
# CONFIG_SCHED_STACK_END_CHECK is not set
# CONFIG_IKHEADERS is not set
# CONFIG_IP_PNP is not set
# CONFIG_IP_PNP_DHCP is not set
# CONFIG_ARM64_SW_TTBR0_PAN is not set
CONFIG_PM_WAKELOCKS_GC=y

# SukiSU-Ultra (Manual Hook, no SUSFS, with KPM)
CONFIG_KSU=y
# CONFIG_KPROBES is not set
# CONFIG_KSU_SUSFS is not set
CONFIG_KPM=y
